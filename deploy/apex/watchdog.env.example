# --- lip-watchdog (patch 17, 2026-10-01). Engine ignores LIP_WD_*.
LIP_KILL_FILE=/var/lib/lip-maker/KILL
LIP_WD_INTERVAL_S=30
LIP_WD_HEARTBEAT_STALE_S=90
LIP_WD_FEED_STALE_S=120
LIP_WD_GRACE_S=240
LIP_WD_DAILY_LOSS=-50
# Worst-case settlement loss of UNPAIRED legs (paired YES+NO is not counted).
LIP_WD_MAX_INVENTORY_USD=500
# Must be >= the engine's max planned budget (LIP_BANKROLL=1500, pinned in
# lip-unattended.service.d/policy.conf), with headroom for rounding.
LIP_WD_MAX_CAPITAL_USD=1600
LIP_WD_MAX_RESTING=200
LIP_WD_ALERT_MIN_INTERVAL_S=600
LIP_WD_ALERT_MAX_PER_HOUR=12
# Consecutive failed watchdog ticks before the watchdog latches itself.
LIP_WD_TICK_FAILS=3
# Fallback when the kill file cannot be written. Needs the polkit rule in deploy/apex/README.md.
LIP_WD_STOP_CMD=systemctl stop lip-unattended
# Live cancel-all is a real API write ONLY when this watchdog's own config is armed:
# LIP_WD_LIVE_ARMED=true AND LIP_PAPER!=true (in THIS file; the engine takes LIP_PAPER from
# its unit drop-in), plus a trading key in LIP_WD_KALSHI_KEY_ID / LIP_WD_KALSHI_KEY_PATH.
# Armed by config, it cancels when the engine reports live, OR was ever seen live (persisted
# until --reset), OR /status is unreachable. If the engine reports live while this is not armed,
# the watchdog TRIPS ("engine live but watchdog unarmed").
LIP_WD_LIVE_ARMED=false
# Cancel scope: ours = only client_order_id starting with LIP_WD_COID_PREFIX (comma list);
# all = every resting order on the account (shared with the Weather engine).
LIP_WD_CANCEL_SCOPE=ours
LIP_WD_COID_PREFIX=LIP-
# ntfy push (free, no account). Disabled: uncomment to enable, subscribe to this topic in the ntfy app.
#LIP_WD_NTFY_TOPIC=<random-unguessable-topic>
