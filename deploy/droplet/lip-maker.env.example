# Paper/demo only. Secrets belong in this file on the droplet, mode 600,
# or in files named by the *_PATH variables. Do not commit real values.
LIP_PAPER=true
LIP_RAMP_PHASE=4
LIP_BANKROLL=5000
# Demo order key. Unused while LIP_PAPER=true. Not the production read key.
# LIP_KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/etc/lip-maker/kalshi.pem
# Production market data for paper mode. Read-only. Separate from the demo key.
# KALSHI_PROD_READ_KEY_ID=
# KALSHI_PROD_READ_KEY_PATH=/etc/lip-maker/kalshi-prod-read.pem
# LIP_ALERT_WEBHOOK=
# Durable-focus defaults. Unset keeps these values. 0 on the close gate turns it off.
# The short-close gate uses the earlier of close_time and occurrence_datetime.
# LIP_MIN_HOURS_TO_CLOSE=48
# LIP_LONG_DATED_EVENT_DAYS=95
# LIP_LONG_DATED_ANY_DAYS=120
# LIP_MATCH_SERIES_DENY=(?i)(?:MATCH|GAME|FIGHT|BOUT)$
# LIP_SPORTS_CATEGORIES=sports,esports
# LIP_SUSPECT_USD_PER_100_DAY=40
# LIP_CANDIDATE_TOP=1000
# LIP_SUBSCRIBE_LIMIT is read only when LIP_CANDIDATE_TOP is unset.
# LIP_MARKET_CACHE=/var/lib/lip-maker/market_meta.json
