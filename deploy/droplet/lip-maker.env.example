# Paper/demo only. Secrets belong in this file on the droplet, mode 600,
# or in files named by the *_PATH variables. Do not commit real values.
LIP_PAPER=true
LIP_RAMP_PHASE=4
LIP_BANKROLL=5000
# Demo order key. Unused while LIP_PAPER=true. Not the production read key.
# LIP_KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/etc/lip-maker/kalshi.pem
# Production market data for paper mode. Read-only. Separate from the demo key.
# KALSHI_PROD_READ_KEY_ID=
# KALSHI_PROD_READ_KEY_PATH=/etc/lip-maker/kalshi-prod-read.pem
# LIP_ALERT_WEBHOOK=
